{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /*
     * `node --test` runs the domain and data tests by stripping types at load time rather than
     * compiling them, so every source file must use erasable syntax only: no `enum`, no
     * `namespace`, no constructor parameter properties. This flag makes the compiler enforce that
     * instead of letting a test fail at runtime with a confusing parse error.
     */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    /*
     * Node's native TypeScript loader resolves what is literally written, so intra-project imports
     * carry the `.ts` extension. Safe here because the project never emits via tsc.
     */
    "allowImportingTsExtensions": true,

    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
